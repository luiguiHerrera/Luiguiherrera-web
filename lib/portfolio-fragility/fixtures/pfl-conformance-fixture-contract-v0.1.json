{
  "contract_id": "pfl-conformance-fixture-contract",
  "schema_id": "pfl-conformance-fixture-schema",
  "schema_version": "0.1.0",
  "methodology_version": "pfl-methodology/0.1.0",
  "scenario_registry_version": "pfl-scenario-registry/0.1.0",
  "status": "FROZEN",
  "encoding": "UTF-8",
  "contract_format": "LANGUAGE_NEUTRAL_CONTRACT_DSL_NOT_EXECUTABLE_JSON_SCHEMA",
  "purpose": "Language-neutral deterministic contract for Python-reference and cross-language conformance fixtures.",
  "normative_rules": {
    "number_model": "IEEE-754 binary64",
    "intermediate_rounding": "FORBIDDEN",
    "non_finite_numbers": "FORBIDDEN",
    "signed_zero_serialization": 0,
    "date_format": "YYYY-MM-DD",
    "date_semantics": "calendar_date_without_timezone",
    "asset_order": "ascending Unicode code-point order by asset_id",
    "date_order": "ascending ISO-8601 calendar date",
    "summation": "Neumaier compensated summation or an implementation proven equivalent within the frozen tolerance",
    "covariance_algorithm": "deterministic two-pass sample covariance with compensated means and centered cross-products",
    "missing_data": "complete-case valuation dates; no forward fill; no pairwise deletion",
    "reporting_currency": "required explicit engine input; no implicit default or hidden FX assumption",
    "historical_return_basis": "consistent documented adjusted total-return basis by default; price-only approximation requires explicit opt-in",
    "annualization_factor": 252,
    "comparison_formula": "abs(actual - expected) <= absolute + relative * abs(expected)",
    "json_object_member_order": "not_significant",
    "json_array_order": "significant unless a field explicitly declares set semantics"
  },
  "default_tolerances": {
    "weights_and_concentration": {
      "absolute": 1e-12,
      "relative": 1e-12
    },
    "market_data_calculations": {
      "absolute": 1e-10,
      "relative": 1e-9
    },
    "identities": {
      "absolute": 1e-10,
      "relative": 0
    },
    "dates_statuses_ids_booleans_nulls_cluster_membership": "EXACT"
  },
  "fixture_document_schema": {
    "required": [
      "fixture_id",
      "schema_version",
      "methodology_version",
      "scenario_registry_version",
      "calculation",
      "inputs",
      "expected",
      "comparison"
    ],
    "properties": {
      "fixture_id": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      },
      "schema_version": {
        "const": "0.1.0"
      },
      "methodology_version": {
        "const": "pfl-methodology/0.1.0"
      },
      "scenario_registry_version": {
        "const": "pfl-scenario-registry/0.1.0"
      },
      "calculation": {
        "enum": [
          "WEIGHT_NORMALIZATION",
          "CONCENTRATION",
          "RETURN_ALIGNMENT",
          "STATIC_SHARE_PATH",
          "SAMPLE_RISK",
          "RISK_CONTRIBUTION",
          "DIVERSIFICATION_RATIO",
          "BEHAVIOUR_CLUSTERING",
          "DRAWDOWN",
          "HISTORICAL_REPLAY",
          "HYPOTHETICAL_STRESS",
          "REMOVE_HOLDING",
          "CHANGE_HOLDING",
          "UNAVAILABLE_PROPAGATION",
          "END_TO_END"
        ]
      },
      "description": {
        "type": "string"
      },
      "inputs": {
        "$ref": "#input_contract"
      },
      "expected": {
        "$ref": "#output_contract"
      },
      "comparison": {
        "type": "object",
        "required": [
          "default_tolerance_class"
        ],
        "properties": {
          "default_tolerance_class": {
            "enum": [
              "weights_and_concentration",
              "market_data_calculations",
              "EXACT"
            ]
          },
          "field_overrides": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "const": "EXACT"
                },
                {
                  "type": "object",
                  "required": [
                    "absolute",
                    "relative"
                  ],
                  "properties": {
                    "absolute": {
                      "type": "number",
                      "minimum": 0
                    },
                    "relative": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "invariants": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "provenance": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "input_contract": {
    "portfolio": {
      "required": [
        "reporting_currency",
        "holdings"
      ],
      "fields": {
        "reporting_currency": "ISO-4217 string",
        "holdings": [
          {
            "asset_id": "stable string; unique",
            "raw_weight": "finite number >= 0",
            "native_currency": "ISO-4217 string",
            "return_basis": "TOTAL_RETURN or PRICE_RETURN_SPLIT_ADJUSTED",
            "primary_scenario_bucket": "explicit enum value or OTHER"
          }
        ]
      },
      "constraints": [
        "at least one raw_weight > 0",
        "shorts, leverage, derivatives, and liabilities unsupported in v0.1",
        "zero-weight assets excluded from calculations"
      ]
    },
    "series": {
      "price_or_total_return_values": [
        {
          "asset_id": "string",
          "date": "YYYY-MM-DD",
          "value": "finite number > 0"
        }
      ],
      "fx_values_when_required": [
        {
          "currency_pair": "BASE_PER_LOCAL",
          "date": "YYYY-MM-DD",
          "value": "finite number > 0"
        }
      ],
      "duplicate_rule": "reject duplicate asset/date unless values and metadata are identical",
      "forward_fill": false,
      "maximum_return_endpoint_gap_calendar_days": 7
    },
    "analysis": {
      "as_of": "YYYY-MM-DD",
      "risk_window_max_aligned_returns": 252,
      "risk_window_min_aligned_returns": 60,
      "low_sample_range_inclusive": [
        60,
        251
      ],
      "path_mode": "STATIC_SHARES_NO_REBALANCING",
      "annualization_factor": 252
    },
    "historical_replay": {
      "episode_id": "versioned registry ID",
      "requested_start": "YYYY-MM-DD",
      "requested_end": "YYYY-MM-DD",
      "start_alignment": "first complete-case date on/after requested_start and within 5 calendar days",
      "end_alignment": "last complete-case date on/before requested_end and within 5 calendar days",
      "return_basis_policy": "consistent documented adjusted total return by default",
      "price_only_approximation": {
        "default": false,
        "when_false_and_only_price_data_exists": "UNAVAILABLE_PRICE_ONLY",
        "when_true_requires": [
          "explicit_user_opt_in",
          "affected_asset_ids",
          "PRICE_RETURN_ONLY quality flag",
          "visible distributions-omitted limitation"
        ],
        "mixed_basis_requires": "MIXED_RETURN_BASIS quality flag and visible limitation"
      },
      "proxy_opt_in": {
        "default": false,
        "consent_scope": "SESSION_ONLY_PER_ASSET_EPISODE_MAPPING",
        "reuse_for_other_episode_or_session": "FORBIDDEN",
        "when_true_requires": [
          "proxy_asset_id",
          "proxy_name",
          "source",
          "mapping_rationale",
          "affected_dates",
          "visible_limitation"
        ]
      }
    },
    "hypothetical_stress": {
      "direct_shocks": "map asset_id or resolved primary bucket to arithmetic shock >= -1",
      "asset_override_precedence": "asset override replaces bucket shock; shocks never stack",
      "volatility_multipliers": "map asset_id or resolved bucket to finite number >= 0",
      "correlation_convergence_lambda": "finite number in [0,1]",
      "probability": "FORBIDDEN"
    },
    "counterfactual": {
      "remove_asset_id": "optional stable asset ID",
      "change": {
        "asset_id": "stable asset ID",
        "target_normalized_weight": "number in [0,1]",
        "funding_rule": "PROPORTIONAL_OTHER_HOLDINGS"
      }
    }
  },
  "output_contract": {
    "available_result": {
      "required": [
        "status",
        "quality_flags"
      ],
      "shape": {
        "status": "OK",
        "calculation_specific_fields": "finite JSON numbers, structured objects, or ordered arrays as direct members beside status and quality_flags",
