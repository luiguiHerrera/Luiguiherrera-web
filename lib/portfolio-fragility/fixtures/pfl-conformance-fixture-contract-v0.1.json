  "formula_registry": {
    "normalized_weight": "raw_weight_i / compensated_sum(raw_weights)",
    "simple_return": "value_t / value_t_minus_1 - 1",
    "static_share_quantity": "normalized_weight_i / value_i_start",
    "static_share_wealth": "compensated_sum(quantity_i * value_i_t)",
    "hhi": "sum(normalized_weight_i^2)",
    "effective_holdings": "1 / hhi",
    "sample_covariance_daily": "sum((x-mean_x)*(y-mean_y))/(T-1)",
    "covariance_annual": "252 * covariance_daily",
    "volatility_annual": "sqrt(252 * sample_variance_daily)",
    "correlation": "covariance_daily/(daily_vol_i*daily_vol_j)",
    "portfolio_variance": "w_transpose * covariance_annual * w",
    "portfolio_volatility": "sqrt(portfolio_variance)",
    "marginal_contribution_to_volatility": "(covariance_annual*w)_i/portfolio_volatility",
    "component_contribution_to_volatility": "w_i*marginal_contribution_i",
    "percentage_contribution_to_volatility": "component_contribution_i/portfolio_volatility",
    "diversification_ratio": "sum(w_i*asset_volatility_i)/portfolio_volatility",
    "cluster_distance": "sqrt(0.5*(1-correlation))",
    "cluster_linkage": "complete linkage; merge threshold sqrt(0.15); lexicographic tie break",
    "drawdown": "wealth_t/running_peak_t-1",
    "direct_stress_return": "sum(w_i*resolved_arithmetic_shock_i)",
    "volatility_stress_covariance": "diag(k*sigma)*R*diag(k*sigma)",
    "correlation_convergence": "(1-lambda)*R+lambda*ones_matrix",
    "remove_holding": "set selected weight to 0 and divide every other weight by 1-selected_weight",
    "change_holding": "set selected weight to x and multiply every other weight by (1-x)/(1-old_selected_weight)"
  },
