ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
CME_FEDWATCH_API_URL=
CME_OAUTH_TOKEN_URL=
CME_FEDWATCH_CLIENT_ID=
CME_FEDWATCH_CLIENT_SECRET=
CME_FEDWATCH_CURRENT_RANGE=

# Separate job only; public requests always execute V1. Missing means OFF.
V2_SHADOW_JOB_ENABLED=OFF
# Legacy explicit local diagnostic utilities only; unused by public requests/job.
V2_SHADOW=OFF
# Private TEST/LOCAL paths, never an approved production durable backing.
V2_SHADOW_DIR=
V2_SHADOW_INPUT=

# Separate S3 shadow job configuration; no credentials belong in this file.
# Configure these as GitHub repository variables only after remote integration.
AWS_REGION=us-east-1
S3_BUCKET=
SHADOW_ROLE_ARN=
# Manual preflight has no market requests. A future canary requires an explicit
# RUN_ONE_SHADOW_OBSERVATION confirmation and separate Control Tower approval.
