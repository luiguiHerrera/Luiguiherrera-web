{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExactGitHubRepositoryAndDefaultBranch",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::732159826922:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:luiguiHerrera/Luiguiherrera-web:ref:refs/heads/vercel-deployment"
        }
      }
    }
  ]
}
